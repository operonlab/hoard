        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에 일치하는 파일이 없습니다."
          }
        }
      }
    },
    "「%@」裡讀得到的部分沒有檔案。\n%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
