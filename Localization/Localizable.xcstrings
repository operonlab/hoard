        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoard がアンインストールできるのは「アプリケーション」フォルダ（/Applications または ~/Applications）内の App のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoard는 응용 프로그램 폴더(/Applications 또는 ~/Applications)에 있는 App만 제거할 수 있습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hoard 只能解除安裝「應用程式」資料夾（/Applications 或 ~/Applications）裡的 App。"
          }
        }
      }
    },
    "Hoard 執行期間放回檔案、更新備份或遇到問題時，會列在這裡。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored files, updated backups, and problems appear here while Hoard is running."
