        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の読み取れる部分にファイルはありません。\n%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에서 읽을 수 있는 부분에는 파일이 없습니다.\n%@"
